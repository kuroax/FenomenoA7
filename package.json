  },
  "homepage": "https://github.com/kuroax/FenomenoA7#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1"
  }
