{
  "name": "fenomenoa7",
  "version": "1.0.0",
  "description": "",
  "main": "script.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npm run compile:css && concurrently -k \"npm:dev:css\" \"npm:dev:server\"",
    "compile:css": "tailwindcss -i ./src/input.css -o ./public/assets/styles.css",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/assets/styles.css --watch",
    "dev:server": "browser-sync start --server public --files \"public/**/*.html,public/**/*.js,public/**/*.css\" --port 3000 --listen 127.0.0.1 --no-open --no-ui --no-notify --no-online",
    "build": "tailwindcss -i ./src/input.css -o ./public/assets/styles.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroax/FenomenoA7.git"
  },
